{
  // Scripts and end-to-end tests run in Node, and the hub's code must not see Node's types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts", "e2e", "browser", "playwright.config.ts", "playwright.browser.config.ts"]
}
